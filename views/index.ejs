<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>감성길드 갤러리</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <% if (round == 1) { %>
    <div class="event-banner">
      <h1>
        <span class="warm">감성</span> &amp; <span class="cool">이성</span> 길드
      </h1>
      <h1>코디 이벤트</h1>
      <h3>참여 기간 ~4/25</h3>
      <h3>투표 기간 4/26 ~ 4/27</h3>
      <h3>투표는 이후 별도의 링크로 제공됩니다.</h3>
    </div>
  <% } else if (round == 2) { %>
    <div class="event-banner">
      <img src="/banner/banner2-3.png" alt="이벤트 배너" style="width: 100%; height: auto; display: block;" />
    </div>
  <% } %>
  <div class="round-links" style="text-align:center; padding: 10px;">
    <% if (round == 1) { %>
      <a href="/round/2" style="margin: 0 10px;">2회차 바로가기(진행중!)</a>
    <% } else if (round == 2) { %>
      <a href="/round/1" style="margin: 0 10px;">1회차 다시보기</a>
    <% } %>
  </div>

  <div class="gallery">
    <% images.forEach(image => { %>
      <div class="photo-item" onclick="openModal('<%= image.src %>')">
        <img src="<%= image.src %>" alt="<%= image.title %>">
        <h3><%= image.title %></h3>
      </div>
    <% }) %>
  </div>

  <!-- 모달 -->
  <div id="myModal" class="modal">
    <span class="close" onclick="closeModal()">&times;</span>
    <img class="modal-content" id="modalImage">
  </div>

  <script>
    // 모달 열기
    function openModal(src) {
      document.getElementById("myModal").style.display = "block";
      document.getElementById("modalImage").src = src;
    }

    // 모달 닫기
    function closeModal() {
      document.getElementById("myModal").style.display = "none";
    }

    // 모달 외부 클릭 시 닫기
    window.onclick = function(event) {
      var modal = document.getElementById("myModal");
      if (event.target == modal) {
        closeModal();
      }
    }
  </script>
</body>
</html>
